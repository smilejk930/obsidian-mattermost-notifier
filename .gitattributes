# Set the default behavior to normalize all text files to LF on checkout and commit.
* text=auto eol=lf

# Ensure text files explicitly use LF line endings
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
